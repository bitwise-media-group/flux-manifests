# Overlay sourced ON TOP of google.env for the google keyed-signing render
# pass: the KMS signing mode's cluster-vars convention -- the key set, the
# keyless identities empty, the public half published for the per-namespace
# cosign-pub Secrets.
SIGNED_IDENTITY_KMS_KEY=projects/ci-test-project/locations/us-central1/keyRings/platform/cryptoKeys/signing/cryptoKeyVersions/1
SIGNED_IDENTITY_ISSUER=
SIGNED_IDENTITY_CHARTS=
SIGNED_IDENTITY_IMAGES=
SIGNED_IDENTITY_MANIFESTS=
COSIGN_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFdGVzdAotLS0tLUVORCBQVUJMSUMgS0VZLS0tLS0K

# This pass doubles as the SPARSE google caller -- the composition that
# reproduced the live empty-var null bug: the SCC caller extras and the
# fallback repository were never passed (unset, exactly as a cluster
# without the SCC pipeline has them), sso runs without a directory SA or
# connectors (reserved vars, published empty / "[]"). Any structured
# manifest that turns one of these into a null value fails the
# null-substitution guard here before it can fail a cluster.
unset SCC_AUDIENCE SCC_PUSH_SA SCC_ORGANIZATION SCC_ASSET_SCOPE SCC_ASSET_SA
unset PATCHY_FALLBACK_REPOSITORY
DEX_DIRECTORY_SA=
DEX_CONNECTORS='[]'
