# Overlay sourced ON TOP of cluster-vars.env for the keyed-signing render
# pass: the KMS signing mode's cluster-vars convention — the key set, the
# keyless identities empty, the public half published for the per-namespace
# cosign-pub Secrets. CLOUD=aws matches the shipped keyed deployment (and
# exercises the aws branches of every template in the same pass).
CLOUD=aws
OCI_PROVIDER=aws
ARTIFACT_TAG_PROVIDER=ECRArtifactTag
SIGNED_IDENTITY_KMS_KEY=arn:aws:kms:eu-west-2:111111111111:key/00000000-0000-0000-0000-000000000000
SIGNED_IDENTITY_ISSUER=
SIGNED_IDENTITY_CHARTS=
SIGNED_IDENTITY_IMAGES=
SIGNED_IDENTITY_MANIFESTS=
COSIGN_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFdGVzdAotLS0tLUVORCBQVUJMSUMgS0VZLS0tLS0K
DNS_ZONE_ID=Z0123456789ABCDEFGHIJ
OTEL_REGION=eu-west-2
OTEL_AMP_ENDPOINT=https://aps-workspaces.eu-west-2.amazonaws.com/workspaces/ws-00000000-0000-0000-0000-000000000000/api/v1/remote_write
GATEWAY_EIP_ALLOCATIONS=eipalloc-00000000000000001,eipalloc-00000000000000002
GATEWAY_SUBNETS=subnet-00000000000000001,subnet-00000000000000002
GATEWAY_NLB_TARGET_TYPE=instance
GATEWAY_API_CRDS=true

# The aws module and its callers publish NONE of these -- the google-only
# reserved vars (terraform-google-gke-flux) and the google patchy-app root's
# SCC caller extras. Unset rather than empty, exactly as the shipped aws
# cluster-vars ConfigMap has them, so the strict-substitution check
# (scripts/validate.sh check_strict) catches any manifest reaching for one
# without a := default -- the failure mode the real cluster hits.
unset GCP_PROJECT GCP_PROJECT_NUMBER GCP_REGION OTEL_PROJECT
unset GATEWAY_ADDRESS_NAME DEX_DIRECTORY_SA
unset SCC_AUDIENCE SCC_PUSH_SA SCC_ORGANIZATION SCC_ASSET_SCOPE SCC_ASSET_SA
unset PATCHY_FALLBACK_REPOSITORY
