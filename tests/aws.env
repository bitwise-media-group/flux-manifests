# The full aws caller: every var terraform-aws-eks-flux reserves (flux.tf
# reserved_cluster_vars). Vars the aws module never publishes -- the
# google module's reserved set and the google patchy-app root's SCC caller
# extras -- are deliberately ABSENT, so the strict-substitution check
# catches any aws-tree or common manifest reaching for one without a :=
# default (the failure mode the real cluster hits).
CLUSTER_NAME=ci-test
AWS_ACCOUNT_ID=111111111111
AWS_REGION=eu-west-2
AWS_PARTITION=aws
VPC_ID=vpc-00000000000000001
NODE_SECURITY_GROUP_ID=sg-00000000000000001
CLUSTER_DISCOVERY_TAG=karpenter.sh/discovery
CLUSTER_DISCOVERY_VALUE=ci-test
PLATFORM_REGISTRY=111111111111.dkr.ecr.eu-west-2.amazonaws.com/platform
CONTAINER_REGISTRY=111111111111.dkr.ecr.eu-west-2.amazonaws.com/platform
OCI_PROVIDER=aws
ARTIFACT_TAG_PROVIDER=ECRArtifactTag
SIGNED_IDENTITY_ISSUER="^https://token\.actions\.githubusercontent\.com$"
SIGNED_IDENTITY_CHARTS="^https://github\.com/bitwise-media-group/flux-containers/\.github/workflows/publish\.yaml@refs/heads/main$"
SIGNED_IDENTITY_IMAGES="^https://github\.com/bitwise-media-group/flux-containers/\.github/workflows/publish\.yaml@refs/heads/main$"
SIGNED_IDENTITY_MANIFESTS="^https://github\.com/bitwise-media-group/flux-manifests/\.github/workflows/publish\.yaml@refs/heads/main$"
# Reserved var, published empty in keyless mode (both cluster modules) --
# present-but-empty is the convention the manifests' bare ${VAR} refs rely on.
SIGNED_IDENTITY_KMS_KEY=
FLUX_SYNC_CHANNEL=edge
DNS_ZONE_NAME=patchy-bitwisemedia-co-uk
# split-horizon: both flavours published, so the external-dns render
# exercises the two-entry zoneIdFilters branch (public is the primary)
DNS_PUBLIC_ZONE_ID=Z0123456789ABCDEFGHIJ
DNS_PRIVATE_ZONE_ID=Z9876543210JIHGFEDCBA
DNS_DOMAIN=patchy.bitwisemedia.co.uk
PATCHY_DOMAIN=patchy.bitwisemedia.co.uk
ACME_EMAIL=platform@bitwisemedia.co.uk
GATEWAY_EIP_ALLOCATIONS=eipalloc-00000000000000001,eipalloc-00000000000000002
GATEWAY_IP=203.0.113.10,203.0.113.11
GATEWAY_SUBNETS=subnet-00000000000000001,subnet-00000000000000002
GATEWAY_NLB_SCHEME=internet-facing
GATEWAY_NLB_TARGET_TYPE=instance
GATEWAY_API_CRDS=true
CILIUM_K8S_SERVICE_HOST=A0000000000000000000000000000000.gr7.eu-west-2.eks.amazonaws.com
CILIUM_POD_SUBNET_IDS=["subnet-00000000000000001","subnet-00000000000000002"]
OTEL_REGION=eu-west-2
OTEL_AMP_ENDPOINT=https://aps-workspaces.eu-west-2.amazonaws.com/workspaces/ws-00000000-0000-0000-0000-000000000000/api/v1/remote_write
SECRET_PREFIX=ci-test-
SECRETS_ROLE_PREFIX=arn:aws:iam::111111111111:role/ci-test-secrets-
STACK_COMPONENTS=dex,flux-web,patchy
# every harness elected, so the render covers all three credential syncs
# and the widest runner/model surface
AGENT_HARNESSES=claude,codex,copilot
PATCHY_EVALUATION=true
RBAC_GROUP_VIEWERS=eks-ci-test-viewers
RBAC_GROUP_DEVELOPERS=eks-ci-test-developers
RBAC_GROUP_DEVOPS=eks-ci-test-devops
RBAC_GROUP_ADMINS=eks-ci-test-admins
DEX_CONNECTORS='[{"id":"google","type":"google","name":"Google","secrets":["client-id","client-secret","admin-email"],"config":{"clientID":"$GOOGLE_CLIENT_ID","clientSecret":"$GOOGLE_CLIENT_SECRET","adminEmail":"$GOOGLE_ADMIN_EMAIL","fetchTransitiveGroupMembership":true,"redirectURI":"https://dex.patchy.bitwisemedia.co.uk/callback"}}]'
KARPENTER_NODE_ROLE=ci-test-karpenter-node
KARPENTER_INTERRUPTION_QUEUE=ci-test-karpenter-interruption
KARPENTER_SERVICE_ACCOUNT=karpenter
KARPENTER_NODE_POOL_NAME=default
KARPENTER_INSTANCE_CATEGORIES=c,m,r
KARPENTER_INSTANCE_FAMILIES=
KARPENTER_INSTANCE_SIZES=
KARPENTER_CAPACITY_TYPES=on-demand,spot
KARPENTER_ARCHITECTURES=amd64
KARPENTER_AMI_ALIAS=al2023@latest
KARPENTER_MAX_NODES=10
KARPENTER_CPU_LIMIT=64
KARPENTER_MEMORY_LIMIT=256Gi
KARPENTER_NODE_DISK_GIB=100
KARPENTER_CONSOLIDATION_POLICY=WhenEmptyOrUnderutilized
KARPENTER_CONSOLIDATE_AFTER=1m
KARPENTER_EXPIRE_AFTER=720h
CLAUDE_PROVIDER=anthropic
CLAUDE_ANTHROPIC_AUTH=token
CLAUDE_BEDROCK_REGION=
CLAUDE_BEDROCK_REGION_PREFIX=
CLAUDE_MODEL_MAP=
