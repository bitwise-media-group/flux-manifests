# Overlay sourced ON TOP of aws.env for the aws keyed-signing render pass:
# the KMS signing mode's cluster-vars convention -- the key set, the
# keyless identities empty, the public half published for the per-namespace
# cosign-pub Secrets. The aws base env is already the sparse complement of
# the full google caller (no directory SA), so no extra unsets are needed
# here.
SIGNED_IDENTITY_KMS_KEY=arn:aws:kms:eu-west-2:111111111111:key/00000000-0000-0000-0000-000000000000
SIGNED_IDENTITY_ISSUER=
SIGNED_IDENTITY_CHARTS=
SIGNED_IDENTITY_IMAGES=
SIGNED_IDENTITY_MANIFESTS=
COSIGN_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFdGVzdAotLS0tLUVORCBQVUJMSUMgS0VZLS0tLS0K
# The keyed pass also renders the other side of the karpenter branches: a
# custom AL2023 image selected by name (one name+owner term per owner,
# with the family published and the alias empty) and instance families and
# sizes set, so every optional NodePool requirement renders once. It also
# moves Karpenter off its kube-system default (workload_identity.karpenter
# overridden in terraform), proving every namespaced object follows
# KARPENTER_NAMESPACE and the component creates the namespace itself.
KARPENTER_NAMESPACE=karpenter
KARPENTER_AMI_ALIAS=
KARPENTER_AMI_SELECTOR_TERMS='[{"name":"ci-test-al2023-1.34-*","owner":"111111111111"},{"name":"ci-test-al2023-1.34-*","owner":"222222222222"}]'
KARPENTER_AMI_FAMILY=AL2023
KARPENTER_INSTANCE_FAMILIES=m7g,c7g
KARPENTER_INSTANCE_SIZES=large,xlarge,2xlarge
KARPENTER_ARCHITECTURES=amd64,arm64
