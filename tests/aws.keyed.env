# Overlay sourced ON TOP of aws.env for the aws keyed-signing render pass:
# the KMS signing mode's cluster-vars convention -- the key set, the
# keyless identities empty, the public half published for the per-namespace
# cosign-pub Secrets. The aws base env is already the sparse complement of
# the full google caller (no SCC extras, no directory SA, no fallback
# repository), so no extra unsets are needed here.
SIGNED_IDENTITY_KMS_KEY=arn:aws:kms:eu-west-2:111111111111:key/00000000-0000-0000-0000-000000000000
SIGNED_IDENTITY_ISSUER=
SIGNED_IDENTITY_CHARTS=
SIGNED_IDENTITY_IMAGES=
SIGNED_IDENTITY_MANIFESTS=
COSIGN_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFdGVzdAotLS0tLUVORCBQVUJMSUMgS0VZLS0tLS0K
